# docker/Dockerfile.burdettie — Burdettie OS: A Linux distro that runs Mach-O binaries natively.
#
# This builds the full darwin-loader runtime stack for Linux, installs the
# runtime host binaries for the requested Docker target architecture, and
# optionally stages extracted Xcode/macOS CLI tools for compatibility testing.
#
# Optional imported-tool staging (run on macOS first if needed):
#   ./scripts/extract_xcode_tools.sh
#
# Build (from repo root, host-native by default):
#   docker build -f docker/Dockerfile.burdettie -t burdettie-os .
#
# Force the reference ARM64 lane explicitly:
#   docker build --platform linux/arm64 -f docker/Dockerfile.burdettie -t burdettie-os .
#
# Run all tool tests:
#   docker run --rm burdettie-os
#
# Interactive shell:
#   docker run --rm -it burdettie-os bash

# ── Build LibreSSL 3.3.6 natively ──────────────────────────────────
# Cross-compiling with zig introduces a codegen bug in the EC big-number
# arithmetic ("point is not on curve"), so we build natively in a stage.

FROM debian:bookworm-slim AS libressl-builder

RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc libc6-dev cmake make wget ca-certificates \
    && rm -rf /var/lib/apt/lists/*

ARG LIBRESSL_VERSION=3.3.6
RUN cd /tmp \
    && wget -q "https://ftp.openbsd.org/pub/OpenBSD/LibreSSL/libressl-${LIBRESSL_VERSION}.tar.gz" \
    && tar xzf "libressl-${LIBRESSL_VERSION}.tar.gz" \
    && mkdir build && cd build \
    && cmake "../libressl-${LIBRESSL_VERSION}" \
        -DBUILD_SHARED_LIBS=ON \
        -DLIBRESSL_APPS=OFF \
        -DLIBRESSL_TESTS=OFF \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_PREFIX=/opt/libressl \
    && make -j"$(nproc)" \
    && make install \
    && strip --strip-debug /opt/libressl/lib/*.so*

# Build native Rust replacements for foundational Xcode CLI entrypoints.
# This avoids depending on the host toolchain while still installing /usr/bin
# shims that guest processes can execute inside the runtime image.
FROM rust:1.82-bookworm AS xcode-tools-builder

WORKDIR /workspace

COPY crates/burdettie-xcode-tools/Cargo.toml /workspace/crates/burdettie-xcode-tools/Cargo.toml
COPY crates/burdettie-xcode-tools/src /workspace/crates/burdettie-xcode-tools/src

RUN printf '[workspace]\nresolver = "2"\nmembers = ["crates/burdettie-xcode-tools"]\n\n[workspace.package]\nversion = "0.1.0"\nedition = "2021"\nlicense = "MIT OR Apache-2.0"\n\n[workspace.dependencies]\ntempfile = "3"\n\n[workspace.lints.rust]\n\n[workspace.lints.clippy]\n' > /workspace/Cargo.toml \
    && cargo build --release -p burdettie-xcode-tools --bins

# Build target-arch runtime binaries inside Docker so the image follows the
# requested platform instead of copying tracked ARM64 executables.
FROM rust:1.94-bookworm AS runtime-binaries-builder

WORKDIR /workspace

RUN apt-get update && apt-get install -y --no-install-recommends \
    pkg-config \
    libwayland-dev \
    libxkbcommon-dev \
    libx11-dev \
    libx11-xcb-dev \
    libxcb1-dev \
    libxrandr-dev \
    libxi-dev \
    libxcursor-dev \
    libxinerama-dev \
    libxcb-shape0-dev \
    libxcb-xfixes0-dev \
    && rm -rf /var/lib/apt/lists/*

COPY . /workspace

RUN cargo build --release -p burdettie-plutil -p launchpad \
    && cargo build --release --features gui -p macho-inspect

FROM busybox:1.36 AS apple-libcxx-arm64

RUN mkdir -p /out
COPY docker/apple-libcxx/libc++.so.1.0 /out/libc++.so.1.0

# ── Runtime image ──────────────────────────────────────────────────

FROM debian:bookworm-slim

ARG TARGETARCH

RUN apt-get update && apt-get install -y --no-install-recommends \
    libstdc++6 \
    file \
    libbz2-1.0 \
    zlib1g \
    liblzma5 \
    libarchive13 \
    libacl1 \
    libc++1 \
    libc++abi1 \
    libx11-6 \
    libx11-xcb1 \
    libxcb-shape0 \
    libxcb-xfixes0 \
    libxcb1 \
    libxcursor1 \
    libxi6 \
    libxinerama1 \
    libxkbcommon-x11-0 \
    libxkbcommon0 \
    libxrandr2 \
    locales \
    novnc \
    websockify \
    x11-utils \
    x11vnc \
    xvfb \
    && rm -rf /var/lib/apt/lists/* \
    && echo "en_US.UTF-8 UTF-8" >> /etc/locale.gen \
    && locale-gen

# Install LibreSSL 3.3.6 (matches macOS Sequoia's /usr/bin/openssl).
# Built natively in the libressl-builder stage above.
# The macOS openssl binary is linked against LibreSSL, not OpenSSL 3.x.
# Bundling the real LibreSSL .so files avoids the struct-layout ABI mismatch
# that occurs when LibreSSL symbols resolve to OpenSSL 3.x.
COPY --from=libressl-builder /opt/libressl/lib/libcrypto.so /opt/libressl/lib/
COPY --from=libressl-builder /opt/libressl/lib/libssl.so    /opt/libressl/lib/
COPY --from=libressl-builder /opt/libressl/lib/libtls.so    /opt/libressl/lib/

# Install LibreSSL config — OPENSSLDIR is compiled as /opt/libressl/etc/ssl.
# The openssl CLI needs openssl.cnf for operations like `req`, `ca`, `x509`.
COPY --from=libressl-builder /opt/libressl/etc/ssl/openssl.cnf /opt/libressl/etc/ssl/openssl.cnf
RUN mkdir -p /opt/libressl/etc/ssl/certs

# System identity
RUN echo "burdettie-os 1.0" > /etc/burdettie-release

# Provide SystemVersion.plist so sw_vers and other tools can read macOS version info
RUN mkdir -p /System/Library/CoreServices && \
    printf '<?xml version="1.0" encoding="UTF-8"?>\n\
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">\n\
<plist version="1.0">\n\
<dict>\n\
\t<key>ProductBuildVersion</key>\n\
\t<string>24E248</string>\n\
\t<key>ProductCopyright</key>\n\
\t<string>1983-2025 Apple Inc.</string>\n\
\t<key>ProductName</key>\n\
\t<string>macOS</string>\n\
\t<key>ProductUserVisibleVersion</key>\n\
\t<string>15.4</string>\n\
\t<key>ProductVersion</key>\n\
\t<string>15.4</string>\n\
\t<key>ProductVersionExtra</key>\n\
\t<string>(a)</string>\n\
</dict>\n\
</plist>\n' > /System/Library/CoreServices/SystemVersion.plist

# Install target-arch runtime binaries built in the stage above.
# The workspace target dir is configured in .cargo/config.toml.
# macho-inspect carries the `gui` feature so guest AppKit windows can run
# against the Linux Xvfb/VNC stack shipped in this image.
COPY --from=runtime-binaries-builder /tmp/burdettieOS-target/release/macho-inspect /usr/local/bin/macho-inspect
RUN chmod +x /usr/local/bin/macho-inspect

# Install burdettie-plutil — native Rust replacement for macOS plutil.
# The macOS plutil is a Swift binary needing 273+ Foundation stubs;
# this native implementation handles all plist operations directly.
COPY --from=runtime-binaries-builder /tmp/burdettieOS-target/release/plutil /usr/local/bin/plutil
RUN chmod +x /usr/local/bin/plutil

# Install the native home-screen launcher built for the target Docker arch.
COPY --from=runtime-binaries-builder /tmp/burdettieOS-target/release/launchpad /usr/local/bin/launchpad
RUN chmod +x /usr/local/bin/launchpad

# Install native Rust replacements for the foundational Xcode CLI surface.
COPY --from=xcode-tools-builder /workspace/target/release/xcrun /usr/local/bin/xcrun
COPY --from=xcode-tools-builder /workspace/target/release/xcode-select /usr/local/bin/xcode-select
RUN chmod +x /usr/local/bin/xcrun /usr/local/bin/xcode-select \
    && ln -sf /usr/local/bin/xcrun /usr/bin/xcrun \
    && ln -sf /usr/local/bin/xcode-select /usr/bin/xcode-select \
    && mkdir -p /Applications/Xcode.app/Contents/Developer/Toolchains/XcodeDefault.xctoolchain/usr/bin \
    && mkdir -p /Applications/Xcode.app/Contents/Developer/Platforms/MacOSX.platform/Developer/SDKs/MacOSX.sdk

# Stage optional Mach-O tool binaries extracted from a macOS host.
# The tracked docker/xcode-tools placeholder keeps the base image buildable even
# when no imported tools have been staged yet.
COPY docker/xcode-tools/ /opt/xcode-tools/
RUN mkdir -p /opt/imported-artifacts

# Install the Apple-ABI libc++ shim only for architectures that have a staged
# target-arch build. The checked-in shim is currently ARM64-only; leaving it
# absent on other targets is safer than preloading a wrong-arch ELF.
COPY --from=apple-libcxx-arm64 /out/libc++.so.1.0 /tmp/apple-libcxx/libc++.so.1.0

# Replace system libc++ with the Apple-ABI version so C++ code uses the correct
# string layout when the target-arch shim is available.
RUN set -eux; \
    if [ "${TARGETARCH}" = "arm64" ]; then \
        install -Dm755 /tmp/apple-libcxx/libc++.so.1.0 /opt/apple-libcxx/libc++.so.1.0; \
        ln -sf /opt/apple-libcxx/libc++.so.1.0 /usr/lib/aarch64-linux-gnu/libc++.so.1; \
    else \
        echo "Skipping Apple-ABI libc++ shim for TARGETARCH=${TARGETARCH}; no target-arch build is staged."; \
    fi; \
    rm -rf /tmp/apple-libcxx

# Install test runner and GUI launcher.
COPY scripts/test_xcode_tools_docker.sh /usr/local/bin/test-xcode-tools
COPY scripts/burdettie_gui.sh /usr/local/bin/burdettie-gui
COPY scripts/burdettie_home.sh /usr/local/bin/burdettie-home
COPY scripts/burdettie_gui_session.sh /usr/local/bin/burdettie-gui-session
RUN sed -i 's/\r$//' /usr/local/bin/test-xcode-tools \
    && chmod +x /usr/local/bin/test-xcode-tools \
    && sed -i 's/\r$//' /usr/local/bin/burdettie-gui \
    && chmod +x /usr/local/bin/burdettie-gui \
    && sed -i 's/\r$//' /usr/local/bin/burdettie-home \
    && chmod +x /usr/local/bin/burdettie-home \
    && sed -i 's/\r$//' /usr/local/bin/burdettie-gui-session \
    && chmod +x /usr/local/bin/burdettie-gui-session

ENV BURDETTIE_GUI_DISPLAY=:99 \
    BURDETTIE_GUI_NOVNC_DIR=/usr/share/novnc \
    BURDETTIE_GUI_NOVNC_PORT=6080 \
    BURDETTIE_GUI_SCREEN=1440x900x24 \
    BURDETTIE_GUI_VNC_PORT=5900

EXPOSE 5900 6080

WORKDIR /opt/xcode-tools

# Default: run the imported tool compatibility suite if staged, otherwise smoke
# test the native Rust replacements shipped in the base runtime.
CMD ["test-xcode-tools"]
