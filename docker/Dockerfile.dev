# docker/Dockerfile.dev — Build & lint image for burdettie-os.
#
# Builds the cross-platform subset of crates (Mach-O parsing, analysis,
# run-plan, diff, trust-policy), plus focused Linux pthread-shim regressions.
# This is not the full Linux runtime suite or selected Darwin guest validation.
# Native macOS runtime coverage remains in its existing CI jobs.
#
# Usage:
#   docker build -f docker/Dockerfile.dev -t burdettie-os-dev .
#   docker run --rm burdettie-os-dev cargo test --workspace --lib

FROM rust:1.93.0-bookworm

RUN rustup component add clippy rustfmt

WORKDIR /workspace
COPY . .

# Build only the cross-platform crates (excludes macOS-only crates).
# This validates that the parsing/analysis stack compiles on Linux.
RUN cargo build --locked \
    -p platform-core \
    -p macho-types \
    -p macho-parse \
    -p macho-map \
    -p macho-objc \
    -p macho-resolve \
    -p macho-run-plan \
    -p macho-diff \
    -p trust-policy \
    -p macho-fixtures \
    -p test-harness

# Exercise the actual Linux production shim, not a reimplementation. Retain
# native process failures and refuse an empty or ignored regression group.
RUN timeout 180s cargo test --locked -p libsystem-shims --lib \
    pthread::shims::attribute_lifetime_tests -- --nocapture \
    > /tmp/pthread-attribute-tests.log 2>&1; \
    status=$?; \
    cat /tmp/pthread-attribute-tests.log; \
    test "$status" -eq 0 && \
    grep -F 'test result: ok. 7 passed; 0 failed; 0 ignored;' /tmp/pthread-attribute-tests.log

# Use the same strict lint policy as the macOS CI job, including its explicit
# allowances for test assertions and intentional low-level numeric conversions.
CMD ["cargo", "clippy", "--locked", \
     "-p", "platform-core", \
     "-p", "macho-types", \
     "-p", "macho-parse", \
     "-p", "macho-map", \
     "-p", "macho-objc", \
     "-p", "macho-resolve", \
     "-p", "macho-run-plan", \
     "-p", "macho-diff", \
     "-p", "trust-policy", \
     "-p", "macho-fixtures", \
     "-p", "test-harness", \
     "--all-targets", "--", "-D", "warnings", \
     "-A", "clippy::unwrap-used", \
     "-A", "clippy::expect-used", \
     "-A", "clippy::cast-possible-truncation", \
     "-A", "clippy::cast-sign-loss", \
     "-A", "clippy::cast-possible-wrap", \
     "-A", "clippy::cast-lossless", \
     "-A", "clippy::ptr-as-ptr", \
     "-A", "clippy::print-stderr", \
     "-A", "clippy::redundant-closure-for-method-calls", \
     "-A", "clippy::implicit-clone"]
